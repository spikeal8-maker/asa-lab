+static void asa_primary_emit(const ASAPrimaryTrace* trace, const mjCCDStatus* status) {
+  if (!trace->query || !trace->copied) return;
+  const mjCCDConfig* c = trace->config;
+  const mjCCDObj* a = trace->obj1;
+  const mjCCDObj* b = trace->obj2;
+  const int ints[32] = {trace->query, a->geom, b->geom, a->geom_type, b->geom_type,
+    c->max_iterations, c->max_contacts, c->npolygonmax, c->nmeshdegmax,
+    status->gjk_iterations, status->epa_iterations, status->epa_status, status->nx,
+    trace->packed, trace->face_index, trace->nverts, trace->nfaces, trace->nmap,
+    trace->ids[0], trace->ids[1], trace->ids[2],
+    trace->vertex[0].index1, trace->vertex[0].index2,
+    trace->vertex[1].index1, trace->vertex[1].index2,
+    trace->vertex[2].index1, trace->vertex[2].index2,
+    a->nsupp, b->nsupp, b->data.mesh.nvert, b->data.mesh.graph != NULL, trace->copied};
+  mjtNum words[75];
+  int at = 0;
+  at = asa_primary_append(words, at, trace->lambda, 3);
+  at = asa_primary_append(words, at, trace->face_v, 3);
+  at = asa_primary_append(words, at, &trace->dist2, 1);
+  for (int i = 0; i < 3; i++) {
+    at = asa_primary_append(words, at, trace->vertex[i].vert, 3);
+    at = asa_primary_append(words, at, trace->vertex[i].vert1, 3);
+    at = asa_primary_append(words, at, trace->vertex[i].vert2, 3);
+  }
+  at = asa_primary_append(words, at, trace->x1, 3);
+  at = asa_primary_append(words, at, trace->x2, 3);
+  at = asa_primary_append(words, at, &status->dist[0], 1);
+  at = asa_primary_append(words, at, a->pos, 3);
+  at = asa_primary_append(words, at, a->mat, 9);
+  at = asa_primary_append(words, at, a->size, 3);
+  at = asa_primary_append(words, at, &a->margin, 1);
+  at = asa_primary_append(words, at, b->pos, 3);
+  at = asa_primary_append(words, at, b->mat, 9);
+  at = asa_primary_append(words, at, b->size, 3);
+  at = asa_primary_append(words, at, &b->margin, 1);
+  at = asa_primary_append(words, at, &c->tolerance, 1);
+  at = asa_primary_append(words, at, &c->dist_cutoff, 1);
+  // All values above are copies of completed operations, never reconstructed support/results.
+  // One line only. No floating-point printf conversion and no new WASM/public binding.
+  fputs("ASA_PRIMARY_EPA_V1 ints=", stderr);
+  for (int i = 0; i < 32; i++) fprintf(stderr, "%s%d", i ? "," : "", ints[i]);
+  fputs(" f64le=", stderr);
+  const unsigned char* raw = (const unsigned char*)words;
+  for (int i = 0; i < at * (int)sizeof(mjtNum); i++) fprintf(stderr, "%02x", raw[i]);
+  fputc('\n', stderr);
+}
