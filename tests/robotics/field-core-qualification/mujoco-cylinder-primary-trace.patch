+static uint64_t asa_primary_bits(const mjtNum* value) {
+  uint64_t bits;
+  memcpy(&bits, value, sizeof(bits));
+  return bits;
+}
+
+static int asa_primary_query(const mjCCDConfig* config, const mjCCDObj* obj1,
+                             const mjCCDObj* obj2) {
+  if (config->max_iterations != 100 || config->max_contacts != 1 ||
+      config->npolygonmax != 0 || config->nmeshdegmax != 0 || !config->buffer ||
+      asa_primary_bits(&config->tolerance) != UINT64_C(0x3e45798ee2308c3a) ||
+      asa_primary_bits(&config->dist_cutoff) != 0 ||
+      obj1->geom_type != mjGEOM_CYLINDER || obj2->geom_type != mjGEOM_MESH ||
+      asa_primary_bits(&obj1->margin) != 0 || asa_primary_bits(&obj2->margin) != 0) {
+    return 0;
+  }
+  for (int q = 0; q < 4; q++) {
+    const ASAPrimaryFilter* expected = &asa_primary_filters[q];
+    if (obj1->geom != expected->first || obj2->geom != expected->second) continue;
+    const mjtNum* pieces[6] = {obj1->pos, obj1->mat, obj1->size,
+                                obj2->pos, obj2->mat, obj2->size};
+    const int widths[6] = {3, 9, 3, 3, 9, 3};
+    int equal = 1, at = 0;
+    for (int p = 0; p < 6; p++) {
+      for (int j = 0; j < widths[p]; j++, at++) {
+        if (asa_primary_bits(&pieces[p][j]) != expected->bits[at]) equal = 0;
+      }
+    }
+    if (equal) return q + 1;
+  }
+  return 0;
+}
+
+static void asa_primary_snapshot(ASAPrimaryTrace* trace, const Polytope* pt,
+                                  const Face* face, const int ids[3], const mjtNum lambda[3],
+                                  const mjtNum x1[3], const mjtNum x2[3]) {
+  if (!trace->query) return;
+  trace->copied++;
+  trace->packed = face->verts;
+  trace->face_index = face->index;
+  trace->nverts = pt->nverts;
+  trace->nfaces = pt->nfaces;
+  trace->nmap = pt->nmap;
+  memcpy(trace->ids, ids, sizeof(trace->ids));
+  for (int i = 0; i < 3; i++) trace->vertex[i] = pt->verts[ids[i]];
+  memcpy(trace->lambda, lambda, sizeof(trace->lambda));
+  memcpy(trace->face_v, face->v, sizeof(trace->face_v));
+  trace->dist2 = face->dist2;
+  memcpy(trace->x1, x1, sizeof(trace->x1));
+  memcpy(trace->x2, x2, sizeof(trace->x2));
+}
+
+static int asa_primary_append(mjtNum* out, int at, const mjtNum* values, int count) {
+  memcpy(out + at, values, sizeof(mjtNum) * count);
+  return at + count;
+}
