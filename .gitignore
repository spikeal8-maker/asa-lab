# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out-tsc/
*.tsbuildinfo

# Nx caches / generated
.nx/cache
.nx/workspace-data
tmp/

# Rust / WASM
target/
crates/**/pkg/

# Env & secrets
.env
.env.*
!.env.example
seed-teacher-credentials.txt
*-credentials.txt

# Local database backups and runtime data
/backups/
/data/

# Owner-only visual evidence (tracked release screenshots remain allowed)
/e2e/artifacts/owner-preview/

# Reports (generated artifacts)
reports/*.json
reports/*.txt

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Google Drive sync conflicts. The checkout lives inside a synced folder, so a
# conflict drops "name (1).ext" copies of sources, build output and Nx cache
# beside the originals. They are never part of the project.
.drive-conflicts/
* (1).*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage
coverage/
playwright-report/
test-results/

# Python bytecode
__pycache__/

# Playwright output
reports/playwright/

# dev orchestrator graceful stop marker
.asa-dev-stop
