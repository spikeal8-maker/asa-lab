{
  "name": "@asa-lab/source",
  "version": "0.0.0",
  "private": true,
  "description": "ASA Lab modular education platform monorepo foundation.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint --all",
    "typecheck": "nx run-many -t typecheck --all",
    "boundaries:check": "eslint --config eslint.boundaries.config.mjs \"{apps,packages,contexts,modules}/**/*.{ts,tsx}\" && node tools/validate-context-boundaries.mjs",
    "contracts:check": "node tools/validate-contracts.mjs",
    "compose:check": "node tools/validate-compose.mjs",
    "test": "vitest run",
    "build": "nx run-many -t build --all",
    "db:migrate": "node tools/migrate.mjs --apply",
    "db:migrate:check": "node tools/migrate.mjs --check",
    "db:migrate:test": "node tools/migrate.mjs --smoke",
    "test:migration:embedded": "vitest run tests/migration/migrate.integration.spec.ts",
    "security:secrets": "node tools/secret-scan.mjs",
    "security:dependencies": "node tools/dependency-inventory.mjs",
    "graph:report": "nx graph --file=docs/project-map/nx-project-graph.json",
    "db:seed:dev": "node tools/seed-dev.mjs",
    "demo": "node tools/demo.mjs",
    "dev": "node tools/dev.mjs",
    "test:rls": "vitest run tests/portal/rls.spec.ts",
    "e2e:portal": "playwright test e2e/teacher-portal.spec.ts",
    "test:ports": "node tools/check-ports.mjs",
    "test:startup": "node tools/check-startup.mjs",
    "test:tenant-context": "vitest run tests/portal/tenant-context.spec.ts",
    "test:authz": "vitest run tests/portal/authz.spec.ts",
    "test:portal-api": "vitest run tests/portal/portal-api.spec.ts",
    "db:test:provision": "node tools/provision-test-db.mjs",
    "test:a11y": "playwright test e2e/accessibility.spec.ts e2e/ui-states.spec.ts",
    "test:visual-system": "node tools/validate-visual-system.mjs",
    "portal:m4:check": "node tools/validate-portal-evidence.mjs",
    "test:electronics": "vitest run contexts/electronics/testing",
    "test:project-slice": "vitest run contexts/projects/testing tests/portal/projects-api.spec.ts",
    "e2e:electronics": "playwright test e2e/electronics-slice.spec.ts",
    "test:electronics-assets": "vitest run tests/electronics/assets.spec.ts"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@axe-core/playwright": "4.10.2",
    "@electric-sql/pglite": "0.2.17",
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@playwright/test": "1.55.1",
    "@types/node": "^22.10.5",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.8.0",
    "nx": "23.1.0",
    "prettier": "^3.4.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "6.4.3",
    "vitest": "^3.2.6",
    "yaml": "^2.7.0"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.1",
    "@fastify/static": "10.1.2",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "fastify": "^5.2.1",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "fast-uri@>=3.0.0 <=3.1.3": "3.1.4",
      "fast-uri@>=4.0.0 <=4.1.0": "4.1.1",
      "find-my-way@<=9.6.0": "9.7.0",
      "brace-expansion@5.0.6": "5.0.8",
      "axios@>=1.15.2 <1.18.0": "1.18.0"
    }
  }
}
