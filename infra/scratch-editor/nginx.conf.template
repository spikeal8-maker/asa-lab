server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /vendor/scratch/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ @scratch_vendor;
    }

    location @scratch_vendor {
        root /usr/share/nginx/html/vendor/scratch;
        try_files $uri /index.html;
    }
}
