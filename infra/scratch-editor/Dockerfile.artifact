# Package an exact-SHA GitHub Actions artifact, without rebuilding upstream Scratch.
# Context: standalone/ plus configure-artifact.mjs and nginx.conf from the same Git SHA.
FROM node:22.23.2-bookworm-slim AS prepared
ARG ASA_BUILD_REVISION
ARG ASA_BLOCKS_PARENT_ORIGIN
WORKDIR /artifact
COPY standalone/ ./standalone/
COPY configure-artifact.mjs ./configure-artifact.mjs
RUN node configure-artifact.mjs ./standalone "$ASA_BUILD_REVISION" "$ASA_BLOCKS_PARENT_ORIGIN"

FROM nginx:1.27.5-alpine
ARG ASA_BUILD_REVISION
LABEL org.opencontainers.image.revision="${ASA_BUILD_REVISION}"
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=prepared /artifact/standalone/ /usr/share/nginx/html/
USER 101:101
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=6 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
