# `tools/asa-lab.sh up` and `tools/asa-lab.ps1 up` generate a private `.env`
# automatically. Copy this file manually only for an operator-managed setup,
# then replace every secret before starting containers.
# Profile overlays provide distinct project names. Set COMPOSE_PROJECT_NAME only
# when an explicit custom project name is required.
# Production example: COMPOSE_PROJECT_NAME=asa-lab-production. Never change the
# project name of an existing deployment unless its PostgreSQL volume is being
# migrated deliberately.
ASA_IMAGE_TAG=local
# Match the WSL owner of the checkout so test evidence remains writable.
# Run `id -u` and `id -g` inside WSL to obtain these values.
ASA_TEST_UID=1000
ASA_TEST_GID=1000

POSTGRES_DB=asalab
POSTGRES_USER=asalab_admin
POSTGRES_PASSWORD=replace-with-url-safe-admin-password
ASA_APP_DB_PASSWORD=replace-with-url-safe-runtime-password

# The migration container receives only this dedicated admin URL. These three
# values must independently attest the same target database.
MIGRATION_DATABASE_URL=postgres://asalab_admin:replace-with-url-safe-admin-password@postgres:5432/asalab
MIGRATION_EXPECT_DATABASE=asalab
MIGRATION_CONFIRM=APPLY:asalab
APP_DATABASE_URL=postgres://asalab_app:replace-with-url-safe-runtime-password@postgres:5432/asalab
ASA_SETTINGS_ENCRYPTION_KEY=replace-with-32-byte-base64url-or-64-character-hex-key
ASA_PUBLIC_WEB_ORIGINS=https://asa-lab.ru,https://www.asa-lab.ru,https://lab.alikinas.ru
# The API is reachable only through the Compose web proxy. Forwarded client
# addresses are trusted solely from this internal Docker range.
ASA_TRUSTED_PROXY_CIDRS=172.16.0.0/12

ASA_WEB_PORT=4610
ASA_API_PORT=4611

# Operator-managed staging and production databases must not receive demo data.
ASA_SEED_DEV=false
ASA_SEED_WORKSPACE=school-1580
ASA_SEED_TEACHER_EMAIL=teacher@school-1580.local
ASA_SEED_TEACHER_PASSWORD=replace-with-local-teacher-password
