{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "rootDir": "src",
    "outDir": "dist",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@asa-lab/contracts": ["packages/contracts/dist/index.d.ts"],
      "@asa-lab/domain-kernel": ["packages/domain-kernel/src/index.ts"],
      "@asa-lab/eventing": ["packages/eventing/src/index.ts"],
      "@asa-lab/ui-kit": ["packages/ui-kit/src/index.ts"],
      "@asa-lab/test-kit": ["packages/test-kit/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.cjs"],
  "exclude": ["dist", "**/*.spec.ts"]
}
