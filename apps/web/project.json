{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": ["type:app", "scope:app"],
  "targets": {
    "build": {
      "command": "tsc -p apps/web/tsconfig.json"
    },
    "typecheck": {
      "command": "tsc -p apps/web/tsconfig.json --noEmit"
    },
    "lint": {
      "command": "eslint apps/web/src"
    }
  }
}
