{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "tags": ["type:app", "scope:app"],
  "targets": {
    "build": {
      "command": "vite build -c apps/web/vite.config.ts",
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/tools/web-private-symbols.mjs",
        "{workspaceRoot}/tools/browser-error-symbols.mjs",
        "{workspaceRoot}/tools/web-symbols-public.pem",
        "{workspaceRoot}/tools/web-build-revision.mjs",
        { "env": "VITE_ASA_BUILD_REVISION" },
        { "env": "VITE_ASA_BUILT_AT" },
        { "env": "VITE_ASA_BLOCKS_PREVIEW" },
        { "env": "VITE_ASA_BLOCKS_RUNTIME_ORIGIN" },
        { "env": "ASA_CAPTURE_PUBLICATION_GRAPH" },
        { "env": "ASA_WEB_PORT" },
        { "env": "ASA_API_PORT" },
        { "env": "NODE_ENV" },
        {
          "runtime": "node tools/web-build-revision.mjs"
        }
      ],
      "outputs": ["{workspaceRoot}/apps/web/dist", "{workspaceRoot}/apps/web/private-symbols"]
    },
    "typecheck": {
      "command": "tsc -p apps/web/tsconfig.json --noEmit"
    },
    "lint": {
      "command": "eslint apps/web/src"
    },
    "serve": {
      "command": "vite -c apps/web/vite.config.ts"
    }
  }
}
