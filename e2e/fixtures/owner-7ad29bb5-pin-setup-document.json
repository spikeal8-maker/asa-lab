        "arduinoSource": "// C++ code generated by ASA Lab\n// Arduino Uno R3\n\nfloat x = 0;\n\nvoid setup()\n{\n  x = 1;\n}\n\nvoid loop()\n{\n  // Эффект 1\n  for (int repeatIndex = 0; repeatIndex < 5; repeatIndex++) {\n    for (int repeatIndex = 0; repeatIndex < 10; repeatIndex++) {\n      x += 1;\n      {\n        int asaOutputPin = x;\n        pinMode(asaOutputPin, OUTPUT);\n        digitalWrite(asaOutputPin, HIGH);\n      }\n      {\n        int asaOutputPin = (x - 1);\n        pinMode(asaOutputPin, OUTPUT);\n        digitalWrite(asaOutputPin, LOW);\n      }\n      {\n        int asaOutputPin = (11 - x);\n        pinMode(asaOutputPin, OUTPUT);\n        digitalWrite(asaOutputPin, HIGH);\n      }\n      {\n        int asaOutputPin = (12 - x);\n        pinMode(asaOutputPin, OUTPUT);\n        digitalWrite(asaOutputPin, LOW);\n      }\n      if ((10 < x)) {\n        x = 0;\n      }\n      delay(100);\n    }\n    x = 1;\n  }\n  // Эффект 2\n  for (int repeatIndex = 0; repeatIndex < 5; repeatIndex++) {\n    for (int repeatIndex = 0; repeatIndex < 10; repeatIndex++) {\n      x += 1;\n      {\n        int asaOutputPin = x;\n        pinMode(asaOutputPin, OUTPUT);\n        digitalWrite(asaOutputPin, HIGH);\n      }\n      {\n        int asaOutputPin = (x - 1);\n        pinMode(asaOutputPin, OUTPUT);\n        digitalWrite(asaOutputPin, LOW);\n      }\n      if ((10 < x)) {\n        x = 0;\n      }\n      delay(100);\n    }\n    x = 1;\n  }\n  // Эффект 3\n  for (int repeatIndex = 0; repeatIndex < 5; repeatIndex++) {\n    x = 0;\n    for (int repeatIndex = 0; repeatIndex < 10; repeatIndex++) {\n      x += 1;\n      {\n        int asaOutputPin = x;\n        pinMode(asaOutputPin, OUTPUT);\n        digitalWrite(asaOutputPin, HIGH);\n      }\n      delay(100);\n    }\n    x = 0;\n    for (int repeatIndex = 0; repeatIndex < 10; repeatIndex++) {\n      x += 1;\n      {\n        int asaOutputPin = x;\n        pinMode(asaOutputPin, OUTPUT);\n        digitalWrite(asaOutputPin, LOW);\n      }\n      delay(100);\n    }\n  }\n  // Эффект 4\n  for (int repeatIndex = 0; repeatIndex < 5; repeatIndex++) {\n    x = 0;\n    for (int repeatIndex = 0; repeatIndex < 10; repeatIndex++) {\n      x += 1;\n      {\n        int asaOutputPin = x;\n        pinMode(asaOutputPin, OUTPUT);\n        digitalWrite(asaOutputPin, HIGH);\n      }\n    }\n    delay(100);\n    x = 0;\n    for (int repeatIndex = 0; repeatIndex < 10; repeatIndex++) {\n      x += 1;\n      {\n        int asaOutputPin = (x - 1);\n        pinMode(asaOutputPin, OUTPUT);\n        digitalWrite(asaOutputPin, LOW);\n      }\n    }\n    x = 1;\n    delay(100);\n  }\n}\n",
