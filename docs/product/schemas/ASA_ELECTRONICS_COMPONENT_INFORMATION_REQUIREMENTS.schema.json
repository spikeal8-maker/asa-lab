{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asa-lab.ru/schemas/electronics/component-information-requirements.v1.json",
  "title": "ASA Lab electronics component information requirements ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "spec", "status", "decisions", "requirements"],
  "properties": {
    "schema": { "type": "string", "minLength": 1 },
    "schema_version": { "const": "1.1.0" },
    "spec": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "approved", "superseded"] },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    }
  },
  "$defs": {
    "decisionId": {
      "type": "string",
      "pattern": "^DEC-INFO-[0-9]{3}$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^ELEC-INFO-[0-9]{3}$"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decision", "status", "blocking_scopes", "evidence_required"],
      "properties": {
        "id": { "$ref": "#/$defs/decisionId" },
        "decision": { "type": "string", "minLength": 1 },
        "status": { "enum": ["owner_direction", "pending_owner", "approved", "rejected"] },
        "blocking_scopes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["data_foundation", "desktop_ux", "mobile_ux", "content"] }
        },
        "evidence_required": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "resolution": { "$ref": "#/$defs/decisionResolution" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "rejected" } },
            "required": ["status"]
          },
          "then": {
            "required": ["resolution"],
            "properties": {
              "resolution": { "required": ["accepted_alternative"] }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "approved" } },
            "required": ["status"]
          },
          "then": { "required": ["resolution"] }
        }
      ]
    },
    "decisionResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "decided_by", "decided_at", "evidence"],
      "properties": {
        "commit_sha": { "$ref": "#/$defs/sha" },
        "decided_by": { "type": "string", "minLength": 1 },
        "decided_at": { "type": "string", "format": "date-time" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "accepted_alternative": { "type": "string", "minLength": 1 }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "normative_sections",
        "status",
        "activation",
        "depends_on_decisions",
        "verification",
        "planned_test_path",
        "planned_fixture_path",
        "gate",
        "assertions",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/requirementId" },
        "statement": { "type": "string", "minLength": 1 },
        "normative_sections": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "status": { "enum": ["planned", "implemented", "verified", "blocked"] },
        "activation": { "enum": ["mandatory", "after_decisions"] },
        "depends_on_decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/decisionId" }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["unit", "integration", "browser", "visual", "accessibility", "content_review", "build"] }
        },
        "planned_test_path": { "type": "string", "minLength": 1 },
        "planned_fixture_path": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "minLength": 1 },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": { "$ref": "#/$defs/requirementEvidence" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "activation": { "const": "after_decisions" } },
            "required": ["activation"]
          },
          "then": {
            "properties": { "depends_on_decisions": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "verified" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "result": { "const": "pass" },
                  "verified_sha": { "$ref": "#/$defs/sha" }
                },
                "required": ["result", "verified_sha", "artifacts"]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "blocked" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "activation": { "const": "after_decisions" },
              "depends_on_decisions": { "minItems": 1 }
            }
          }
        }
      ]
    },
    "requirementEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "verified_sha", "artifacts"],
      "properties": {
        "result": { "enum": ["not_run", "pass", "fail"] },
        "verified_sha": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }]
        },
        "artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    }
  }
}
