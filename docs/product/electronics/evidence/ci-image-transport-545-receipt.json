                "run": "docker compose -f compose.yaml -f .github/compose.registry-ci.yaml build --build-arg NODE_IMAGE=public.ecr.aws/docker/library/node@sha256:43aeff40f4afc22e83f7589a2f37e111cff5ca84529571f1c8415bcc5fcc21b2 --build-arg CADDY_IMAGE=public.ecr.aws/docker/library/caddy@sha256:d8c17a862962def15cde69863a3a463f25a2664942eafd7bdbf050e9c3116b83 --build-arg BUILDKIT_SYNTAX=mirror.gcr.io/docker/dockerfile@sha256:b5f3b260a9678e1d83d2fce86eeddf79420b79147eaba2a25986f47133d73720 api web"
              },
              {
                "shell": "bash",
                "run": "set -euo pipefail\napi_revision=\"$(docker image inspect --format='{{ index .Config.Labels \"org.opencontainers.image.revision\" }}' \"asa-lab-api:${ASA_IMAGE_TAG}\")\"\nweb_revision=\"$(docker image inspect --format='{{ index .Config.Labels \"org.opencontainers.image.revision\" }}' \"asa-lab-web:${ASA_IMAGE_TAG}\")\"\ntest \"$api_revision\" = \"$ASA_BUILD_REVISION\"\ntest \"$web_revision\" = \"$ASA_BUILD_REVISION\"\n"
              },
              {
                "shell": "bash",
                "run": "set -euo pipefail\nmkdir -p review-images\ndocker save \"asa-lab-api:${ASA_IMAGE_TAG}\" | gzip -1 > \"review-images/asa-lab-api-${ASA_IMAGE_TAG}.tar.gz\"\ndocker save \"asa-lab-web:${ASA_IMAGE_TAG}\" | gzip -1 > \"review-images/asa-lab-web-${ASA_IMAGE_TAG}.tar.gz\"\nprintf 'revision=%s\\napi=%s\\nweb=%s\\n' \\\n  \"$ASA_BUILD_REVISION\" \\\n  \"asa-lab-api:${ASA_IMAGE_TAG}\" \\\n  \"asa-lab-web:${ASA_IMAGE_TAG}\" > review-images/MANIFEST.txt\nsha256sum review-images/*.tar.gz > review-images/SHA256SUMS\n"
              },
              {
                "uses": "actions/upload-artifact@v4",
                "with": {
                  "name": "electronics-review-images-${{ github.run_id }}",
                  "path": "review-images",
                  "if-no-files-found": "error",
                  "retention-days": 14
                }
              }
            ]
          }
        },
        "required_triggers": {
          "pull_request": {
            "paths": [
              "compose.test.yaml",
              ".github/compose.registry-ci.yaml",
              "apps/api/src/origin-policy.ts",
              "apps/api/src/app.factory.ts",
              "AGENTS.md",
              "contexts/electronics/**",
              "apps/web/src/electronics/**",
              "apps/web/src/pages/SchematicEditor.tsx",
              "apps/web/vite.config.ts",
              "apps/web/tsconfig.json",
              "e2e/electronics-simulation.spec.ts",
              "e2e/electronics-interactions.spec.ts",
              "tests/electronics/**",
              "tools/run-electronics-benchmark.mjs",
              "tools/run-electronics-browser-benchmark.mjs",
              "tools/run-electronics-load-benchmark.mjs",
              "tools/run-electronics-memory-benchmark.mjs",
              "tools/update-electronics-benchmark-golden.mjs",
              "docs/delivery/evidence/electronics-opt0/**",
              "package.json",
              "pnpm-lock.yaml",
              ".github/workflows/electronics-r4-m1-focused.yml"
            ]
          },
          "workflow_dispatch": null
        }
      }
    }
  }
