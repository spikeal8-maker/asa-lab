{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "index.ts",
    "module.ts",
    "domain/**/*.ts",
    "editor.ts",
    "editor/**/*.ts",
    "editor/**/*.tsx"
  ],
  "exclude": ["dist", "testing"]
}
