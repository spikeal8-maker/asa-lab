{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:4611
	}

	handle /health/* {
		reverse_proxy api:4611
	}

	# Content-hashed build output may be held for a year; nothing else may.
	# The match is on the filename shape, never on the directory: /assets/ also
	# carries owner-supplied electronics artwork copied verbatim from public/,
	# which has no hash and must stay revalidated.
	@hashed path_regexp hashed \-[A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$
	handle @hashed {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Electronics uses a real browser path so that a saved project survives a
	# refresh. It is the only non-file SPA path; hash routes reach the root
	# document and never arrive at the server.
	@spa path /projects/* /max-login /max-login/
	handle @spa {
		root * /srv
		rewrite * /index.html
		header X-Robots-Tag "noindex, nofollow"
		# The entry document names the hashed chunks, so holding it would point
		# visitors at files the next deploy has already replaced.
		header Cache-Control "no-cache"
		file_server
	}

	# Real public SEO pages and assets are served as files. Unknown paths now
	# keep Caddy's 404 instead of becoming a soft-404 copy of the SPA document.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		file_server
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}
