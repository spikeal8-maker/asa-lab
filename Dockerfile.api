# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22.23.2-bookworm-slim

FROM ${NODE_IMAGE} AS workspace

ARG ASA_BUILD_REVISION=unknown
ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}

RUN corepack enable \
    && corepack prepare pnpm@9.15.9 --activate

WORKDIR /workspace
COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm build
RUN pnpm --filter @asa-lab/api deploy --prod /opt/asa-api

FROM ${NODE_IMAGE} AS browser

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN npx --yes playwright@1.55.1 install --with-deps chromium \
    && chmod -R a+rX /ms-playwright

FROM browser AS test

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
ENV COREPACK_HOME=/pnpm/corepack

RUN corepack enable \
    && corepack prepare pnpm@9.15.9 --activate

WORKDIR /workspace
COPY . .

RUN pnpm install --frozen-lockfile
RUN pnpm build

USER node

FROM ${NODE_IMAGE} AS runtime

ARG ASA_BUILD_REVISION=unknown
LABEL org.opencontainers.image.revision="${ASA_BUILD_REVISION}"
ENV NODE_ENV=production
ENV API_HOST=0.0.0.0
ENV API_PORT=4611
ENV ASA_BUILD_REVISION="${ASA_BUILD_REVISION}"
ENV NODE_EXTRA_CA_CERTS=/app/certs/russian-trusted-root-ca.pem

WORKDIR /app

COPY --from=workspace --chown=node:node /opt/asa-api/ ./
COPY --from=workspace --chown=node:node /workspace/migrations ./migrations
COPY --from=workspace --chown=node:node /workspace/tools/migrate.mjs ./tools/migrate.mjs
COPY --from=workspace --chown=node:node /workspace/tools/seed-dev.mjs ./tools/seed-dev.mjs
COPY --from=workspace --chown=node:node /workspace/docker/provision-runtime-role.mjs ./docker/provision-runtime-role.mjs
COPY --from=workspace --chown=node:node /workspace/docker/certs/russian-trusted-root-ca.pem ./certs/russian-trusted-root-ca.pem
COPY --from=workspace --chown=node:node --chmod=0555 /workspace/docker/api-entrypoint.sh ./docker/api-entrypoint.sh
COPY --from=workspace --chown=node:node --chmod=0555 /workspace/docker/migrate-entrypoint.sh ./docker/migrate-entrypoint.sh

USER node

EXPOSE 4611

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:4611/health/live').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]

ENTRYPOINT ["./docker/api-entrypoint.sh"]
