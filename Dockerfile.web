# syntax=docker/dockerfile:1.7

ARG NODE_IMAGE=node:22.23.4-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da
ARG CADDY_IMAGE=caddy:2.11.7-alpine@sha256:e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5

FROM ${NODE_IMAGE} AS build

ENV PNPM_HOME=/pnpm
ENV PATH=${PNPM_HOME}:${PATH}

RUN corepack enable \
    && corepack prepare pnpm@9.15.9 --activate

WORKDIR /workspace
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=asa-pnpm9,target=/pnpm/store pnpm fetch --frozen-lockfile --store-dir /pnpm/store
COPY . .

RUN --mount=type=cache,id=asa-pnpm9,target=/pnpm/store pnpm install --offline --frozen-lockfile --store-dir /pnpm/store
ARG ASA_BUILD_REVISION=unknown
ARG ASA_BLOCKS_PREVIEW=0
ARG ASA_BLOCKS_RUNTIME_ORIGIN=
ENV VITE_ASA_BUILD_REVISION="${ASA_BUILD_REVISION}"
ENV VITE_ASA_BLOCKS_PREVIEW="${ASA_BLOCKS_PREVIEW}"
ENV VITE_ASA_BLOCKS_RUNTIME_ORIGIN="${ASA_BLOCKS_RUNTIME_ORIGIN}"
RUN NX_SKIP_NX_CACHE=true pnpm nx run web:build --skip-nx-cache

# Export encrypted symbols from the identical build used by runtime below.
FROM scratch AS web-symbols
COPY --from=build /workspace/apps/web/private-symbols /

FROM ${CADDY_IMAGE} AS runtime

ARG ASA_SECURITY_PATCHSET=2026-11-02

ARG ASA_BUILD_REVISION=unknown
LABEL org.opencontainers.image.revision="${ASA_BUILD_REVISION}"
ENV ASA_BUILD_REVISION="${ASA_BUILD_REVISION}"
ENV XDG_CONFIG_HOME=/tmp/caddy-config
ENV XDG_DATA_HOME=/tmp/caddy-data

RUN test -n "$ASA_SECURITY_PATCHSET" \
    && apk upgrade --no-cache \
    && setcap -r /usr/bin/caddy

COPY docker/web/Caddyfile /etc/caddy/Caddyfile
COPY --chmod=0555 docker/web/start.sh /usr/local/bin/asa-web-start
COPY --from=build /workspace/apps/web/dist /srv
COPY --from=build /workspace/apps/web/private-symbols /usr/share/asa-web-symbols

USER 65534:65534
ENTRYPOINT ["/usr/local/bin/asa-web-start"]

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD ["wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8080/health/live"]
