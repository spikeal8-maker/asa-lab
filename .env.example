# ASA Lab local environment example. Copy to .env for local development.
# Never commit real secrets. These are safe local placeholders only.

# API
API_HOST=127.0.0.1
API_PORT=3000

# PostgreSQL (local docker compose)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=asalab
POSTGRES_USER=asalab
POSTGRES_PASSWORD=local-dev-password
DATABASE_URL=postgres://asalab:local-dev-password@127.0.0.1:5432/asalab

# Redis (local docker compose)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# MinIO / S3-compatible object storage (local docker compose)
MINIO_ROOT_USER=asalab
MINIO_ROOT_PASSWORD=local-dev-password
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=asalab-local

# OpenTelemetry
OTEL_SERVICE_NAME=asa-lab-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
