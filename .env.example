# ASA Lab — environment template (copy to .env.local; never commit secrets).
# Ports are canonical per docs/delivery/LOCAL_PORT_POLICY.md.
ASA_WEB_PORT=4610
ASA_API_PORT=4611
ASA_E2E_PORT=4612

# Only this browser origin may call API mutation endpoints in development.
# The API's own same-origin built SPA on 4611 is allowed automatically.
ASA_WEB_ORIGIN=http://127.0.0.1:4610

# Runtime application role (no BYPASSRLS, owns nothing) - the ONLY URL the API receives.
APP_DATABASE_URL=postgres://asalab_app:CHANGE_ME@127.0.0.1:5433/asalab

# Admin/migration connection - migrations, seed and admin tools only. Never given to the API.
DATABASE_URL=postgres://asalab:CHANGE_ME@127.0.0.1:5433/asalab

# Isolated test database (guarded; the name MUST end in _test).
# Admin connection: migration smoke, test seeding, provisioning.
TEST_DATABASE_URL=postgres://asalab:CHANGE_ME@127.0.0.1:5433/asalab_test
# Runtime-role connection to the SAME *_test database: integration/E2E suites.
APP_TEST_DATABASE_URL=postgres://asalab_app:CHANGE_ME@127.0.0.1:5433/asalab_test
# Prepare/reset the isolated test DB: pnpm db:test:provision [--reset]
# (requires DATABASE_URL, TEST_DATABASE_URL and ASA_APP_DB_PASSWORD).
