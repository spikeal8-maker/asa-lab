# Normalize line endings to LF in the repo (consistent across Windows/macOS/Linux)
* text=auto eol=lf

# Windows-specific scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Explicit binaries (never normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.pdf binary
*.wasm binary

# Preserve owner-supplied SVG evidence byte-for-byte with its recorded SHA-256.
apps/web/public/assets/electronics/owner-supplied/*.svg binary

# Keep the audited owner archive imports byte-identical to their manifest hashes.
apps/web/public/assets/electronics/owner-audit/components/** binary

# The runtime component database is an immutable, byte-exact projection of owner SVG files.
apps/web/public/assets/electronics/component-database/components/** binary
